{
  "name": "@contra/cli",
  "version": "0.20.0",
  "private": true,
  "type": "module",
  "description": "Command line interface for the Contra workspace.",
  "license": "MIT",
  "bin": {
    "contra": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@contra/core": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "6.0.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
