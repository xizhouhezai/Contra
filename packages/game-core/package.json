    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {},
  "devDependencies": {
    "rimraf": "6.0.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
