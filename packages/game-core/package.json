{
  "name": "@contra/game-core",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Pure TypeScript gameplay rules: entity data types and the core event model.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
